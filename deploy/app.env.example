# Install as /etc/electronic-pancake/app.env, mode 0600, owner root.
# Never commit the installed file or include it in a release archive.
NODE_ENV=production
PORT=3001
HOST=127.0.0.1
PUBLIC_ORIGIN=https://digitalpancake.top
TRUST_PROXY=1
SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32
DATABASE_PATH=/var/lib/electronic-pancake/site.sqlite
UPLOAD_DIR=/var/lib/electronic-pancake/uploads
# Required by the one-time init-owner command. Users sign in with this email.
OWNER_EMAIL=owner@example.com
OWNER_NICKNAME=Admin
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=pancakeking@digitalpancake.top
SMTP_PASS=
SMTP_FROM=pancakeking@digitalpancake.top
ICP_FILING_NUMBER=
